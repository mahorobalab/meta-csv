{
  "name": "meta-csv",
  "displayName": "MetaText Editor",
  "description": "High-performance CSV, TSV, JSONL & Log editor and viewer with JSONC sidecar metadata (.metatext.jsonc)",
  "version": "0.1.0",
  "publisher": "meta-csv",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [
    "onCustomEditor:metaCsv.editor",
    "onCommand:metaCsv.openWithEditor"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "metaCsv.editor",
        "displayName": "MetaText Editor",
        "selector": [
          { "filenamePattern": "*.csv" },
          { "filenamePattern": "*.tsv" },
          { "filenamePattern": "*.jsonl" },
          { "filenamePattern": "*.ndjson" },
          { "filenamePattern": "*.log" }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "metaCsv.openWithEditor",
        "title": "MetaText Editor: Open with MetaText Editor"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "metaCsv.openWithEditor",
          "when": "resourceExtname == .csv || resourceExtname == .tsv || resourceExtname == .jsonl || resourceExtname == .ndjson || resourceExtname == .log",
          "group": "navigation"
        }
      ]
    },
    "languages": [
      {
        "id": "jsonc",
        "extensions": [".metatext.jsonc"]
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": ["*.metatext.jsonc"],
        "url": "./schemas/metatext.schema.json"
      }
    ],
    "configuration": {
      "title": "MetaText Editor",
      "properties": {
        "metaCsv.defaultFontSize": {
          "type": "number",
          "default": 13,
          "minimum": 9,
          "maximum": 32,
          "description": "Default cell font size in pixels when not specified in .metatext.jsonc."
        },
        "metaCsv.defaultRowHeight": {
          "type": "number",
          "default": 28,
          "minimum": 20,
          "maximum": 200,
          "description": "Default row height in pixels when not specified in .metatext.jsonc."
        },
        "metaCsv.defaultMarkerColor": {
          "type": "string",
          "enum": ["amber", "rose", "emerald", "sky", "violet"],
          "default": "amber",
          "description": "Default highlight color when adding a new row marker."
        },
        "metaCsv.showRowNumbers": {
          "type": "boolean",
          "default": true,
          "description": "Show 1-based row numbers in the left gutter."
        },
        "metaCsv.noHeaderColumnStyle": {
          "type": "string",
          "enum": ["excel", "numbered"],
          "default": "excel",
          "description": "Column header naming style when the first row is not a header ('excel' for A, B, C... or 'numbered' for column 1, 2, 3...)."
        }
      }
    }
  },
  "scripts": {
    "build:ext": "esbuild src/extension.ts --bundle --platform=node --format=cjs --outfile=dist/extension.js --external:vscode --sourcemap",
    "build:webview": "vite build",
    "build": "pnpm run build:ext && pnpm run build:webview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "test": "echo \"no tests in vscode\""
  },
  "dependencies": {
    "@meta-csv/core": "workspace:*",
    "@meta-csv/schema": "workspace:*",
    "@meta-csv/ui": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "vite": "^6.2.2"
  }
}
