{
  "name": "metatext-editor",
  "displayName": "MetaText Editor",
  "description": "%extension.description%",
  "version": "0.1.0",
  "publisher": "metatext-editor",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "metatext.editor",
        "displayName": "MetaText Editor",
        "selector": [
          { "filenamePattern": "*.csv" },
          { "filenamePattern": "*.tsv" },
          { "filenamePattern": "*.jsonl" },
          { "filenamePattern": "*.ndjson" },
          { "filenamePattern": "*.log" }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "metatext.openWithEditor",
        "title": "%command.openWithEditor%"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "metatext.openWithEditor",
          "when": "resourceExtname == .csv || resourceExtname == .tsv || resourceExtname == .jsonl || resourceExtname == .ndjson || resourceExtname == .log",
          "group": "navigation"
        }
      ]
    },
    "languages": [
      {
        "id": "jsonc",
        "extensions": [".metatext.jsonc"]
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": ["*.metatext.jsonc"],
        "url": "./schemas/metatext.schema.json"
      }
    ],
    "configuration": {
      "title": "MetaText Editor",
      "properties": {
        "metatext.language": {
          "type": "string",
          "enum": ["auto", "en", "ja", "zh-cn", "zh-tw", "ko", "de", "fr", "es"],
          "default": "auto",
          "description": "%config.language.description%"
        },
        "metatext.defaultFontSize": {
          "type": "number",
          "default": 13,
          "minimum": 9,
          "maximum": 32,
          "description": "%config.defaultFontSize.description%"
        },
        "metatext.defaultRowHeight": {
          "type": "number",
          "default": 28,
          "minimum": 20,
          "maximum": 200,
          "description": "%config.defaultRowHeight.description%"
        },
        "metatext.defaultMarkerColor": {
          "type": "string",
          "enum": ["amber", "rose", "emerald", "sky", "violet"],
          "default": "amber",
          "description": "%config.defaultMarkerColor.description%"
        },
        "metatext.showRowNumbers": {
          "type": "boolean",
          "default": true,
          "description": "%config.showRowNumbers.description%"
        },
        "metatext.noHeaderColumnStyle": {
          "type": "string",
          "enum": ["excel", "numbered"],
          "default": "excel",
          "description": "%config.noHeaderColumnStyle.description%"
        },
        "metatext.sidecarVisibility": {
          "type": "string",
          "enum": ["nest", "hide", "show"],
          "enumDescriptions": [
            "%config.sidecarVisibility.nest%",
            "%config.sidecarVisibility.hide%",
            "%config.sidecarVisibility.show%"
          ],
          "default": "nest",
          "description": "%config.sidecarVisibility.description%"
        }
      }
    }
  },
  "scripts": {
    "build:ext": "esbuild src/extension.ts --bundle --platform=node --format=cjs --outfile=dist/extension.js --external:vscode --sourcemap",
    "build:webview": "vite build",
    "build": "pnpm run build:ext && pnpm run build:webview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "test": "echo \"no tests in vscode\""
  },
  "dependencies": {
    "@metatext-editor/core": "workspace:*",
    "@metatext-editor/schema": "workspace:*",
    "@metatext-editor/ui": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "vite": "^6.2.2"
  }
}
