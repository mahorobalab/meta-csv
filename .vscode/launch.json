{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run MetaText Editor Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode",
        "${workspaceFolder}/../meta-csv-data"
      ],
      "outFiles": ["${workspaceFolder}/apps/vscode/dist/**/*.js"],
      "preLaunchTask": "build-vscode-extension"
    },
    {
      "name": "Run MetaText Editor Desktop (.exe)",
      "type": "node-terminal",
      "request": "launch",
      "command": "& \"${workspaceFolder}/apps/desktop/src-tauri/target/release/metatext-editor.exe\""
    },
    {
      "name": "Build & Run MetaText Editor Desktop (.exe)",
      "type": "node-terminal",
      "request": "launch",
      "preLaunchTask": "build-desktop-exe",
      "command": "& \"${workspaceFolder}/apps/desktop/src-tauri/target/release/metatext-editor.exe\""
    },
    {
      "name": "Run MetaText Editor Desktop (Tauri Dev)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm.cmd dev:desktop"
    }
  ]
}
