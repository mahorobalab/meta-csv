{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-vscode-extension",
      "type": "shell",
      "command": "pnpm --filter metatext-editor build",
      "windows": {
        "command": "pnpm.cmd --filter metatext-editor build"
      },
      "problemMatcher": []
    },
    {
      "label": "build-desktop-exe",
      "type": "shell",
      "command": "pnpm.cmd build:desktop",
      "problemMatcher": []
    },
    {
      "label": "build-desktop-mac",
      "type": "shell",
      "command": "PATH=\"/opt/homebrew/opt/rustup/bin:$PATH\" pnpm build:desktop",
      "problemMatcher": []
    }
  ]
}
