{
  "name": "meta-csv-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @meta-csv/playground dev",
    "dev:desktop": "pnpm --filter @meta-csv/desktop tauri:dev",
    "build:desktop": "pnpm --filter @meta-csv/desktop tauri:build",
    "build:pages": "pnpm --filter @meta-csv/playground build && node scripts/build-pages.mjs",
    "sync:schema": "node scripts/sync-schema.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "metrics": "node scripts/metrics.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
